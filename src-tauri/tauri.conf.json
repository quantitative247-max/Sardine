{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sardine",
  "version": "0.1.0",
  "identifier": "com.quant.margin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Sardine",
        "width": 1320,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "pdfium/*": "pdfium/"
    },
    "shortDescription": "PDF reader with LaTeX notes and spaced repetition",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF",
        "description": "PDF document",
        "role": "Viewer"
      }
    ]
  }
}